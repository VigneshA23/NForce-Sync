{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/social-posts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Anton|Great Vibes|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Anton, Great Vibes, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|key|ref|className|style|children)$/]",
        "message": "<CTA> doesn't accept that prop. Declared props: variant, size, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTA'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|ghost|url)$/]",
        "message": "<CTA> variant must be one of 'solid' | 'ghost' | 'url'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTA'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CTA> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|banner|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: color, banner."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|boxed|showLogo|logoSrc|tone|align|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: url, boxed, showLogo, logoSrc, tone, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Footer> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|between)$/]",
        "message": "<Footer> align must be one of 'center' | 'between'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|strike|key|ref|className|style|children)$/]",
        "message": "<Highlight> doesn't accept that prop. Declared props: tone, strike."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|salmon|yellow|white)$/]",
        "message": "<Highlight> tone must be one of 'red' | 'salmon' | 'yellow' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconFeature'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|sublabel|tone|size|layout|key|ref|className|style|children)$/]",
        "message": "<IconFeature> doesn't accept that prop. Declared props: icon, label, sublabel, tone, size, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconFeature'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|red)$/]",
        "message": "<IconFeature> tone must be one of 'white' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconFeature'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<IconFeature> layout must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|height|variant|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: src, height, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark|wordmark)$/]",
        "message": "<Logo> variant must be one of 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|theme|logo|logoSrc|logoCorner|footer|footerUrl|footerBoxed|pad|key|ref|className|style|children)$/]",
        "message": "<PostFrame> doesn't accept that prop. Declared props: format, theme, logo, logoSrc, logoCorner, footer, footerUrl, footerBoxed, pad."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:landscape|square|portrait)$/]",
        "message": "<PostFrame> format must be one of 'landscape' | 'square' | 'portrait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|ink|red|light)$/]",
        "message": "<PostFrame> theme must be one of 'dark' | 'ink' | 'red' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='logoCorner'] > Literal[value!=/^(?:top-left|top-right)$/]",
        "message": "<PostFrame> logoCorner must be one of 'top-left' | 'top-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|dark)$/]",
        "message": "<Tag> variant must be one of 'solid' | 'outline' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
